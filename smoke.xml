<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Exercise Smoke Suite" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>

    <test name="Critical Path Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginFlowTest"/>
            <class name="tests.ProductCartTest"/>
        </classes>
    </test>

</suite>