<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Exercise Suite" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>

    <test name="UI E-Commerce Regression Tests">
        <classes>
            <class name="tests.LoginFlowTest"/>
            <class name="tests.ProductCartTest"/>
        </classes>
    </test>

    <test name="REST API Regression Tests" parallel="none">
        <classes>
            <class name="tests.api.ProductsAndAuthApiTest"/>
        </classes>
    </test>

</suite>